// Cloudflare Workers deployment (luckydraw.<account>.workers.dev). Cloudflare's build runs `npm run build`,
// then `npx wrangler deploy`, which reads this file.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker's name in the Cloudflare dashboard.
  "name": "luckydraw",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // Builds the app into ./dist before every deploy, whatever build command the dashboard has.
  "build": { "command": "npm run build", "watch_dir": ["src", "functions", "server", "worker"] },
  // Keep variables added in the dashboard (the APP_PASSCODE secret is always kept).
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    // Only the API runs code; the app itself is served straight from the built files.
    "run_worker_first": ["/api/*"]
  },
  // The shared design. No database_id: on the first deploy Wrangler connects the database named "luckydraw"
  // (or creates it if it does not exist yet).
  "d1_databases": [{ "binding": "DB", "database_name": "luckydraw" }],
  "observability": { "enabled": true }
}
